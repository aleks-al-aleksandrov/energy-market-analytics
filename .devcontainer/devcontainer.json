{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/dashboard.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r app/requirements.txt pytest holidays python-dotenv requests scikit-learn lightgbm && echo 'Packages installed'",
  "postAttachCommand": {
    "server": "streamlit run app/dashboard.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "containerEnv": { "EMA_AUTH_DISABLED": "1" },
  "forwardPorts": [
    8501
  ]
}